{
  "formats": {
    "idle": "^(\\[dry-run\\] )?no live epics; nothing started$",
    "pass": "^(\\[dry-run\\] )?(\\d+) open sub-issue\\(s\\) of (\\d+) live epic\\(s\\), taken by their epic's .+; \\d+ of \\d+ run\\(s\\) in flight; at most \\d+ triage run\\(s\\) a pass; items of \\d+ followed repositories only$",
    "item": "^(\\[dry-run\\] )?([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#\\d+) \\(epic ([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#\\d+)\\) (dispatch|triage|skip|dispatch error|triage error): .+$",
    "census": "^- [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#\\d+: (live;|not live,|could not be read:)"
  },
  "hosted": [
    { "label": "Poll", "what": "fixes, merges, marks drafts ready", "repo": "jmarrero-forge/tracker", "workflow": "poll.yml", "job": "poll" },
    { "label": "Board scheduler", "what": "starts Ready items", "repo": "jmarrero-forge/tracker", "workflow": "poll.yml", "job": "board", "read": "scheduler" },
    { "label": "Dispatch", "what": "agent runs", "repo": "jmarrero-forge/tracker", "workflow": "dispatch.yml", "read": "in-flight" }
  ]
}
